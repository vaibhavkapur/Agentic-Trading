#!/usr/bin/env python3
import json
import platform
import statistics
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "src"))
from sentiment.domain import instant
from sentiment.engine import Engine

engine = Engine.load(ROOT)
end = instant("2025-04-23T00:00:00Z")
engine.feed(end, end)
durations = []
for _ in range(200):
    start = time.perf_counter_ns()
    result = engine.feed(end, end)
    durations.append((time.perf_counter_ns() - start) / 1e6)
print(json.dumps(dict(python=platform.python_version(), os=platform.system(),
                      architecture=platform.machine(), model_version=engine.version,
                      measure="warm in-process fixture feed query", unit="ms",
                      iterations=len(durations), canonical_articles=len(engine.reference.articles),
                      returned_decisions=len(result["decisions"]), median=statistics.median(durations),
                      p95_nearest_rank=sorted(durations)[189], maximum=max(durations)), indent=2))
